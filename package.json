{
    "name": "koajax",
    "version": "3.3.3",
    "license": "LGPL-3.0",
    "author": "shiy2008@gmail.com",
    "description": "HTTP Client based on Koa-like middlewares",
    "keywords": [
        "http",
        "request",
        "client",
        "ajax",
        "koa",
        "middleware"
    ],
    "homepage": "https://web-cell.dev/KoAJAX/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EasyWebApp/KoAJAX.git"
    },
    "bugs": {
        "url": "https://github.com/EasyWebApp/KoAJAX/issues"
    },
    "source": "source/index.ts",
    "types": "dist/index.d.ts",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.esm.js",
        "require": "./dist/index.js"
    },
    "dependencies": {
        "@swc/helpers": "^0.5.24",
        "regenerator-runtime": "^0.14.1",
        "web-streams-polyfill": "^4.5.1",
        "web-utility": "^4.8.2"
    },
    "peerDependencies": {
        "core-js": ">=3",
        "jsdom": ">=21"
    },
    "devDependencies": {
        "@parcel/packager-ts": "~2.16.4",
        "@parcel/transformer-typescript-types": "~2.16.4",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.6",
        "abortcontroller-polyfill": "^1.7.8",
        "core-js": "^3.51.0",
        "expect": "^30.5.2",
        "husky": "^9.1.7",
        "jsdom": "^31.0.1",
        "lint-staged": "^17.6.0",
        "open-cli": "^9.0.0",
        "parcel": "~2.16.4",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "~6.0.3"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "tabWidth": 4
    },
    "lint-staged": {
        "*.{md,ts,json,yml}": "prettier --write"
    },
    "browserslist": "> 0.5%, last 2 versions, not dead, IE 11",
    "targets": {
        "main": {
            "optimize": true
        },
        "types": false
    },
    "scripts": {
        "prepare": "husky",
        "check": "lint-staged  &&  tsc --noEmit  &&  tsc --noEmit --project test/tsconfig.json",
        "test": "npm run check  &&  node --import tsx --import ./test/setup.ts --test --test-timeout=10000 test/*.spec.ts",
        "pack-dist": "rm -rf dist/  &&  tsc --emitDeclarationOnly  &&  parcel build",
        "pack-docs": "rm -rf docs/  &&  typedoc source/",
        "build": "npm run pack-dist  &&  npm run pack-docs",
        "help": "npm run pack-docs  &&  open-cli docs/index.html",
        "prepublishOnly": "npm test  &&  npm run build"
    }
}
